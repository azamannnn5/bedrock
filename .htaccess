# Bedrock Lapidary: compression + caching for Hostinger (Apache/LiteSpeed).
# Cuts page weight (the products API JSON, CSS/JS, and static assets)
# without touching PHP/DB code. Safe to leave in even if a directive isn't
# supported, each block is wrapped in an <IfModule> check.

# Clean URLs (no extensions, no query strings):
#   /product/<id>   /category/<cat>   /category/<cat>/<type>
#   /guides   /guides/<slug>   /about /contact /cart /checkout /privacy /terms /returns /warranties
# product.php / category.php / guide.php / guide-post.php do the real work
# (title, meta, canonical, schema from the database); the rules below map the
# clean URLs onto them. Old .html / .php / ?query URLs 301 to the clean ones.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- 1. Legacy URLs -> clean URLs (301). THE_REQUEST makes sure only real
  # browser requests match, never the internal rewrites below (no loops).
  RewriteCond %{THE_REQUEST} \s/product\.(?:html|php)[\s?]
  RewriteCond %{QUERY_STRING} (?:^|&)id=([^&]+)
  RewriteRule ^product\.(?:html|php)$ /product/%1? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/category\.(?:html|php)[\s?]
  RewriteCond %{QUERY_STRING} ^cat=([^&]+)&type=([^&]+)$
  RewriteRule ^category\.(?:html|php)$ /category/%1/%2? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/category\.(?:html|php)[\s?]
  RewriteCond %{QUERY_STRING} ^cat=([^&]+)$
  RewriteRule ^category\.(?:html|php)$ /category/%1? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/category\.(?:html|php)[\s?]
  RewriteRule ^category\.(?:html|php)$ /category [R=301,L]

  RewriteCond %{THE_REQUEST} \s/guide-post\.(?:html|php)[\s?]
  RewriteCond %{QUERY_STRING} (?:^|&)slug=([^&]+)
  RewriteRule ^guide-post\.(?:html|php)$ /guides/%1? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/guide\.(?:html|php)[\s?]
  RewriteRule ^guide\.(?:html|php)$ /guides [R=301,L]

  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/(?:about|contact|cart|checkout|privacy|terms|returns|warranties)\.html[\s?]
  RewriteRule ^(about|contact|cart|checkout|privacy|terms|returns|warranties)\.html$ /$1 [R=301,L]

  # ---- 2. Trailing slash -> no trailing slash (one URL per page).
  RewriteRule ^(product|category|guides)/(.+)/$ /$1/$2 [R=301,L]
  RewriteRule ^(category|guides|about|contact|cart|checkout|privacy|terms|returns|warranties)/$ /$1 [R=301,L]

  # ---- 3. Clean URLs -> real files (internal, URL in the browser never changes).
  RewriteRule ^product/([^/]+)$ product.php?id=$1 [L,QSA]
  RewriteRule ^category/([^/]+)/([^/]+)$ category.php?cat=$1&type=$2 [L,QSA]
  RewriteRule ^category/([^/]+)$ category.php?cat=$1 [L,QSA]
  RewriteRule ^category$ category.php [L,QSA]
  RewriteRule ^guides/([^/]+)$ guide-post.php?slug=$1 [L,QSA]
  RewriteRule ^guides$ guide.php [L,QSA]
  RewriteRule ^(about|contact|cart|checkout|privacy|terms|returns|warranties)$ $1.html [L]

  # /sitemap.xml -> sitemap.php (dynamic, always current with the DB)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Never serve project/dev files (SQL dumps, notes, scripts) even if uploaded.
<FilesMatch "\.(sql|md|py)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Baseline security headers (also clears the crawler's "missing header" warnings).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
